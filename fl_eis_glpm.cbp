<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="tpl_fltk_enh" />
		<Option pch_mode="2" />
		<Option compiler="mingw-builds_gcc_142_compiler" />
		<Option virtualFolders="form1/;main/;form Swc/;main/meta/;fnames/" />
		<Build>
			<Target title="Debug">
				<Option platforms="Windows;" />
				<Option output="fl_eis_glpm_v8_db" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="0" />
				<Option compiler="mingw-builds_gcc_142_compiler" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-ggdb" />
					<Add option="-Og" />
					<Add option="-g" />
					<Add directory="form1" />
					<Add directory="GenContext" />
				</Compiler>
				<Linker>
					<Add library="../lib_shy/libshy_db.a" />
					<Add library="../lib_tree/libtwgtree_db.a" />
					<Add library="libgsl.a" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option platforms="Windows;" />
				<Option output="fl_eis_glpm_v8" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="mingw-builds_gcc_142_compiler" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-s" />
					<Add option="-march=x86-64-v2" />
					<Add directory="form1" />
					<Add directory="GenContext" />
				</Compiler>
				<Linker>
					<Add option="-static -s" />
					<Add library="../lib_tree/libtwgtree.a" />
					<Add library="../lib_shy/libshy.a" />
					<Add library="libgsl.a" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-fno-builtin" />
			<Add option="-fexceptions" />
			<Add option="-DLIBCONFIGXX_STATIC" />
			<Add option="-DWIN32" />
			<Add directory="$(TARGET_COMPILER_DIR)FLTK/include" />
			<Add directory="$(TARGET_COMPILER_DIR)user/include" />
			<Add directory="$(TARGET_COMPILER_DIR)user/include/simplexlsx_last" />
		</Compiler>
		<Linker>
			<Add library="fltk" />
			<Add library="ole32" />
			<Add library="uuid" />
